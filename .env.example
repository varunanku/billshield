# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Which provider /api/bills/extract and the follow-up chat use. Default is
# openrouter; set to "groq" to use the original direct-Groq path instead.
EXTRACTION_PROVIDER=
# Model slug from https://openrouter.ai/models -- defaults to
# google/gemini-2.0-flash-001 in code if left unset.
OPENROUTER_MODEL=

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
