# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Which provider /api/bills/extract uses. Default is gemini; set to "groq"
# to use the original path instead.
EXTRACTION_PROVIDER=
# Model name from https://aistudio.google.com -- e.g. gemini-2.0-flash.
GEMINI_MODEL=

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
